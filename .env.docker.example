# Docker Environment Variables
# Copy this file to .env and update with your production values
# DO NOT commit .env to version control

# PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Medusa Backend
MEDUSA_JWT_SECRET=your_medusa_jwt_secret_here
MEDUSA_COOKIE_SECRET=your_medusa_cookie_secret_here
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=pk_your_publishable_key_here
ADMIN_CORS=http://localhost:7001,http://localhost:9000
STORE_CORS=http://localhost:3000

# Strapi CMS
STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=your_strapi_api_token_salt_here
STRAPI_ADMIN_JWT_SECRET=your_strapi_admin_jwt_secret_here
STRAPI_TRANSFER_TOKEN_SALT=your_strapi_transfer_token_salt_here
STRAPI_JWT_SECRET=your_strapi_jwt_secret_here
STRAPI_API_TOKEN=your_strapi_api_token_here

# Next.js Storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEDUSA_API_URL=http://localhost:9000
STRAPI_API_URL=http://localhost:1337

# Generate secrets with: openssl rand -base64 32
